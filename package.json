{
  "name": "sql-workbench-embedded",
  "version": "0.2.0",
  "description": "Lightweight JavaScript library that transforms static SQL code blocks into interactive, browser-based SQL execution environments using DuckDB WASM",
  "main": "dist/sql-workbench-embedded.js",
  "browser": "dist/sql-workbench-embedded.js",
  "module": "dist/sql-workbench-embedded.esm.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/sql-workbench-embedded.js",
  "jsdelivr": "dist/sql-workbench-embedded.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/sql-workbench-embedded.esm.js",
      "require": "./dist/sql-workbench-embedded.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:types && npm run copy:example",
    "build:types": "tsc --emitDeclarationOnly --declarationMap false",
    "build:prod": "NODE_ENV=production npm run build",
    "copy:example": "cp examples/index.html dist/ && sed -i.bak 's|../src/index.ts|../sql-workbench-embedded.esm.js|' dist/index.html && rm -f dist/index.html.bak",
    "preview": "vite preview",
    "preview:prod": "npm run build:prod && vite preview",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build:prod"
  },
  "keywords": [
    "sql",
    "duckdb",
    "wasm",
    "embed",
    "embedded",
    "embeddable",
    "interactive",
    "sql-editor",
    "sql-workbench",
    "documentation",
    "tutorial",
    "education",
    "queries",
    "in-browser"
  ],
  "author": "TobiLG <tobilg@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobilg/sql-workbench-embedded.git"
  },
  "bugs": {
    "url": "https://github.com/tobilg/sql-workbench-embedded/issues"
  },
  "homepage": "https://github.com/tobilg/sql-workbench-embedded#readme",
  "devDependencies": {
    "@duckdb/duckdb-wasm": "^1.33.1-dev57.0",
    "@types/node": "^22.18.12",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/ui": "^5.0.1",
    "happy-dom": "^20.14.5",
    "jsdom": "^30.1.1",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "@duckdb/duckdb-wasm": "^1.33.1-dev57.0"
  },
  "peerDependenciesMeta": {
    "@duckdb/duckdb-wasm": {
      "optional": true
    }
  }
}
